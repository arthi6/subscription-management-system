# Copy this file to .env and adjust values.
APP_NAME=Subscription Management System
DATABASE_URL=postgresql+psycopg://subs:subs@localhost:5432/subscriptions
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30
FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=billing@brightloop.com
DEFAULT_PAYMENT_TERMS_DAYS=14
BILLING_AUTO_RUN=false
BILLING_INTERVAL_SECONDS=86400
BOOTSTRAP_ADMIN_EMAIL=admin@brightloop.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
